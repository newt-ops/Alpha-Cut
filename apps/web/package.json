{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @alpha-cut/types build",
    "build": "pnpm --filter @alpha-cut/types build && tsc && vite build && pnpm --filter miniapp build && node -e \"const fs=require('fs'); fs.cpSync('../miniapp/dist', 'dist/miniapp', {recursive: true});\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alpha-cut/config": "workspace:*",
    "@alpha-cut/types": "workspace:*",
    "@alpha-cut/ui": "workspace:*",
    "@hookform/resolvers": "^4.1.0",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "hugeicons-react": "^0.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.2.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}

