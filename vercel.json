{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://api.alpha-cut.com/api/:match*"
    },
    {
      "source": "/miniapp",
      "destination": "/miniapp/index.html"
    },
    {
      "source": "/miniapp/",
      "destination": "/miniapp/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

