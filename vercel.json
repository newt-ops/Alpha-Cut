{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "routes": [
    {
      "src": "/miniapp/?(.*)",
      "status": 308,
      "headers": {
        "Location": "https://app.alpha-cut.com/$1"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "https://api.alpha-cut.com/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.alpha-cut.com"
        }
      ],
      "dest": "/miniapp/assets/$1"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.alpha-cut.com"
        }
      ],
      "dest": "/miniapp/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
