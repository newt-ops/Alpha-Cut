{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/miniapp",
      "destination": "https://app.alpha-cut.com/",
      "permanent": true
    },
    {
      "source": "/miniapp/:path*",
      "destination": "https://app.alpha-cut.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://api.alpha-cut.com/api/:match*"
    },
    {
      "source": "/assets/:match*",
      "has": [
        {
          "type": "host",
          "value": "app.alpha-cut.com"
        }
      ],
      "destination": "/miniapp/assets/:match*"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.alpha-cut.com"
        }
      ],
      "destination": "/miniapp/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
