# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/alphacut?retryWrites=true&w=majority

# JWT Secrets for Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_characters

# Google OAuth 2.0 (for Admin & Client Web Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary (Media Previews, Thumbnails & Brand Assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend (Transactional Email & Inquiry Notifications)
RESEND_API_KEY=re_your_resend_api_key_here

# Telegram Bot & Mini App Integration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=alpha_cut_bot
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Admin Founder Emails (Comma-separated whitelist for super_admin access)
ADMIN_EMAILS=alphacutagency@gmail.com

